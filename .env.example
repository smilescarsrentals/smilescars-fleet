# ── Supabase Postgres connection (SERVER-SIDE ONLY — never expose to the browser) ──
# Supabase dashboard: Project Settings > Database > Connection string > "Connection pooling".
# Port 6543 = Transaction pooler (recommended for serverless — many short-lived
# connections). Port 5432 = Session pooler. Either works; swap the port to switch.
#
# NOTE: this variable has no VITE_ prefix on purpose. Vite only ships VITE_*
# variables to the browser, so the password stays on the server where it belongs.
DATABASE_URL=postgresql://postgres.vqfjjmxyvxwdvlyivdfz:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Optional: legacy Google Apps Script Web App /exec URL ──
# Only used as a fallback for actions the Supabase API doesn't implement. Leave
# it unset once the Apps Script is retired — nothing the app does needs it.
# LEGACY_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# ── Optional: point the frontend at a different backend ──
# Unset, the app calls /api on its own domain (the function in this repo).
# Set it to roll back to Apps Script without a code change.
# VITE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# ── Web Push (PWA notifications, Phase 2b/2c) ──
# Generated once via `npx web-push generate-vapid-keys`. The PUBLIC key is
# safe to expose (VITE_ prefix ships it to the browser — it's what
# PushManager.subscribe() uses to identify our server, not a secret). The
# PRIVATE key signs outgoing pushes and must never leave the server —
# no VITE_ prefix, same rule as DATABASE_URL above.
VITE_VAPID_PUBLIC_KEY=BFbvejy_rpQM5d6JmjfYZgXBCIsXihECB6j7VoodLO1F_veOV1gLkeCdJG2EOSCPXCsfDs9rDaPFjnzScabpjLM
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ── Garage invoice scanning (Phase 1) ──
# Server-only, no VITE_ prefix — the photo goes to our own backend, which
# calls Claude's vision API to extract supplier/items/quantities/prices.
# The key never reaches the browser.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
